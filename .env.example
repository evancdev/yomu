# ---- Server ----
PORT=8787

# ---- LLM provider (story/script writer) ----
# Options: mock | anthropic | akamai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Any current Claude model id, e.g. claude-opus-4-8, claude-sonnet-4-6
LLM_MODEL=claude-sonnet-4-6

# ---- Image provider (panel art) ----
# Options: mock | magnific | akamai
IMAGE_PROVIDER=mock
# Magnific REST credentials. The MCP session used during dev is NOT reusable by
# a deployed server, so the Magnific adapter needs its own key + base URL.
# Fill these in once you have a premium account and the REST endpoint.
MAGNIFIC_API_KEY=
MAGNIFIC_API_URL=https://api.magnific.com
# Model slug from the Magnific catalog (or 'auto')
MAGNIFIC_MODEL=auto

# ---- Akamai Inference Cloud (shared by LLM_PROVIDER=akamai and IMAGE_PROVIDER=akamai) ----
# One API key for the account; the LLM + image adapters hit the same base URL.
# OpenAI-compatible endpoints: /v1/chat/completions and /v1/images/generations.
AKAMAI_API_KEY=
AKAMAI_INFERENCE_URL=https://inference.akamai.com
# Model slugs hosted on Inference Cloud.
AKAMAI_LLM_MODEL=llama-3.3-70b-instruct
AKAMAI_IMAGE_MODEL=flux-1-schnell

# ---- Delivery store (optional: persist + edge-deliver rendered panels) ----
# Options: none | akamai
# 'akamai' = Linode Object Storage (S3-compatible) behind Image & Video Manager.
STORAGE_PROVIDER=none
AKAMAI_S3_BUCKET=
AKAMAI_S3_REGION=us-east-1
# Host without the bucket prefix; defaults to <region>.linodeobjects.com.
AKAMAI_S3_ENDPOINT=
AKAMAI_S3_ACCESS_KEY=
AKAMAI_S3_SECRET_KEY=
AKAMAI_S3_PREFIX=panels/
# Image & Video Manager / CDN hostname mapped to the bucket origin. When set,
# panel URLs point here so Akamai serves per-device AVIF/WebP at the edge.
AKAMAI_DELIVERY_BASE=
